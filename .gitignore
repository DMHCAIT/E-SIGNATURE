# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Node Modules & Package Manager Caches
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js
/.next/
/out/
/build/
*.tsbuildinfo
next-env.d.ts

# Offline Scratch Scripts & Build Artifacts
/scratch/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment Variables & Local Secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local

# System Files & OS Caches
.DS_Store
Thumbs.db
*.pem

# IDE & Editor Specific Configuration
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln

# Deployment Services
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
